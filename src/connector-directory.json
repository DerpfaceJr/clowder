 {
  "id": "google-workspace",
  "name": "Google Workspace (trial)",
  "description": "Gmail, Calendar, Drive and Docs for one Google account, through your own Google client. Cats draft email by default; sending asks first. Needs Python with uv (uvx) on this computer.",
  "type": "stdio",
  "command": "uvx",
  "args": [
   "workspace-mcp@2.3.0",
   "--single-user",
   "--tool-tier",
   "core",
   "--tools",
   "gmail",
   "calendar",
   "drive",
   "docs"
  ],
  "env": {
   "GOOGLE_OAUTH_CLIENT_ID": "${OAUTH_CLIENT_ID}",
   "GOOGLE_OAUTH_CLIENT_SECRET": "${OAUTH_CLIENT_SECRET}",
   "USER_GOOGLE_EMAIL": "${OAUTH_EMAIL}",
   "WORKSPACE_MCP_CREDENTIALS_DIR": "${OAUTH_CREDENTIALS_DIR}"
  },
  "auth": "oauth",
  "client": "google",
  "scopes": [
   "openid",
   "https://www.googleapis.com/auth/userinfo.email",
   "https://www.googleapis.com/auth/userinfo.profile",
   "https://www.googleapis.com/auth/gmail.modify",
   "https://www.googleapis.com/auth/gmail.compose",
   "https://www.googleapis.com/auth/gmail.send",
   "https://www.googleapis.com/auth/calendar",
   "https://www.googleapis.com/auth/drive",
   "https://www.googleapis.com/auth/documents"
  ],
  "effects": {
   "send_gmail_message": "public",
   "draft_gmail_message": "write"
  },
  "trial": true,
  "version": "2.3.0",
  "license": "MIT",
  "source": "https://github.com/taylorwilsdon/google_workspace_mcp",
  "needs": "uvx",
  "homepage": "https://workspacemcp.com"
 },
 {
  "id": "ms-365",
  "name": "Microsoft 365 (trial)",
  "description": "Outlook mail, calendar and OneDrive for one Microsoft account, through your own app registration. Cats draft email by default; sending asks first. Needs Node.js (npx).",
  "type": "stdio",
  "command": "npx",
  "args": [
   "-y",
   "@softeria/ms-365-mcp-server@0.179.1",
   "--enabled-tools",
   "mail|draft|calendar|drive"
  ],
  "env": {
   "MS365_MCP_OAUTH_TOKEN": "${OAUTH_ACCESS_TOKEN}"
  },
  "auth": "oauth",
  "client": "microsoft",
  "scopes": [
   "openid",
   "profile",
   "email",
   "offline_access",
   "User.Read",
   "Mail.ReadWrite",
   "Mail.Send",
   "Calendars.ReadWrite",
   "Files.ReadWrite"
  ],
  "effects": {
   "send-mail": "public",
   "send-draft-message": "public",
   "reply-mail-message": "public",
   "reply-all-mail-message": "public",
   "forward-mail-message": "public",
   "create-draft-email": "write",
   "create-reply-draft": "write",
   "create-reply-all-draft": "write",
   "create-forward-draft": "write"
  },
  "trial": true,
  "version": "0.179.1",
  "license": "MIT",
  "source": "https://github.com/Softeria/ms-365-mcp-server",
  "needs": "npx",
  "homepage": "https://github.com/Softeria/ms-365-mcp-server"
 },
 {
  "id": "composio",
  "name": "Composio (managed, cloud)",
  "description": "Hundreds of apps through one managed sign-in. Opt-in: your sign-ins and every tool call and result pass through Composio's cloud. Paste the consumer key from Composio's dashboard.",
  "url": "https://connect.composio.dev/mcp",
  "type": "http",
  "auth": "token",
  "headers": {
   "x-consumer-api-key": "${COMPOSIO_CONSUMER_KEY}"
  },
  "tokenHelp": "Composio dashboard, Install, MCP card: copy the consumer key.",
  "managed": "cloud",
  "homepage": "https://composio.dev"
 }
]
